{
	"compilerOptions": {
		"target": "es2024",
		"lib": [
			"es2024",
			"dom"
		],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": [
			"node"
		],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"skipLibCheck": true
	},
	"include": [
		"scripts",
		"test",
		"src/engine",
		"src/shared"
	],
	// Worker-level tests run the Worker's modules under Node (vitest); the Workers and Node global types don't mix.
	"exclude": [
		"test/worker"
	]
}
